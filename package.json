{
  "name": "ninegrid-learning",
  "version": "0.1.2",
  "description": "九格行动：以赛季任务驱动的个人学习平台",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "test": "vitest run",
    "test:postgres": "tsx scripts/verify-postgres.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "npm run build && electron desktop/main.cjs",
    "desktop:build": "npm run build && node scripts/desktop/create-icon.mjs && node scripts/desktop/stage-runtime.mjs && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^29.1.1",
    "node": "24.11.1",
    "pg-mem": "^3.0.14",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.ninegrid.learning",
    "productName": "九格行动 NineGrid",
    "asar": false,
    "npmRebuild": false,
    "directories": { "output": "release" },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "src/lib/engine.ts",
      "scripts/windows/db-snapshot.mjs",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      { "from": "desktop-runtime/node.exe", "to": "runtime/node.exe" },
      { "from": "desktop-runtime/postgresql18", "to": "postgresql18" },
      { "from": "desktop-build-info.json", "to": "build-info.json" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "desktop/assets/ninegrid.ico",
      "artifactName": "NineGrid-Setup-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "九格行动 NineGrid",
      "deleteAppDataOnUninstall": false
    }
  }
}
