# Only the local server reads this key. Never prefix it with VITE_.
DEEPSEEK_API_KEY=
# Current official Chat Completions model; configurable for future API changes.
DEEPSEEK_MODEL=deepseek-flash
PORT=8787
# Leave HOST at loopback for personal use.
HOST=127.0.0.1

# Optional authenticated multi-user persistence. In production set all values below.
DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://learn.example.com
# Only set when exactly one trusted reverse-proxy hop forwards to this app.
TRUST_PROXY=0
YOUTUBE_API_KEY=
UPLOAD_DIR=./data/uploads
POSTGRES_DB=ninegrid
POSTGRES_USER=ninegrid
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=8787
